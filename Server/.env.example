# Copy to Server/.env and fill in. Never commit the real .env.
APP_PASSWORD=pick-a-password
ANTHROPIC_API_KEY=sk-ant-...
# Any long random string; signs the login cookie. Change it to log everyone out.
SECRET_KEY=replace-with-a-long-random-string
CLAUDE_MODEL=claude-sonnet-5-5
# Cap on new puzzles per hour (protects your API bill)
GENERATE_PER_HOUR=30
